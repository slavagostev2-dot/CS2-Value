        },
        {
          "old": "            if dom_veto and not record.veto:\n                record = replace(record, veto=dom_veto)\n                if progress:\n                    progress(\n                        \"DOM scoreboard Offstage: \"\n                        + \", \".join(\n                            f\"{action.map_name}={action.action}\"\n                            + (f\"({action.team_name})\" if action.team_name else \"\")\n                            for action in dom_veto\n                        )\n                    )\n",
          "new": "            if dom_veto:\n                merged_veto = merge_dom_veto_with_text(dom_veto, record.veto)\n                record = replace(record, veto=merged_veto)\n                if progress:\n                    progress(\n                        \"DOM scoreboard Offstage: \"\n                        + \", \".join(\n                            f\"{action.map_name}={action.action}\"\n                            + (f\"({action.team_name})\" if action.team_name else \"\")\n                            for action in dom_veto\n                        )\n                    )\n            elif progress and record.veto:\n                progress(\"DOM scoreboard Offstage: владельцы PICK пока не определены; использую текстовый map pool.\")\n",
          "count": 1
        }
